# ============================================================================
# Roblox Studio Connect — .env template
#
# TH: คัดลอกไฟล์นี้เป็น ".env" แล้วใส่ค่าของคุณเอง  (cp .env.template .env)
#     ห้าม commit ไฟล์ .env / ห้ามส่ง API Key ในแชต / ห้ามใส่ในโค้ดหรือ command line
# EN: Copy this file to ".env" and fill in your own values  (cp .env.template .env)
#     Never commit .env / never paste the API key into chat, code or the command line
# ============================================================================


# ----------------------------------------------------------------------------
# ROBLOX_API_KEY  (required / จำเป็น)
# ----------------------------------------------------------------------------
# TH: สร้างที่ https://create.roblox.com/dashboard/credentials
#     - ถ้าจะอัปโหลด asset ในนามกลุ่ม (เช่น โมเดล/Animation ของเกมกลุ่ม) ต้องสร้างคีย์ "ในหน้ากลุ่ม"
#       (Creator Dashboard → เลือกกลุ่มมุมซ้ายบน → Open Cloud → API Keys) ไม่ใช่คีย์ส่วนตัว
#     - Access Permissions → กด "Add API System" แล้วติ๊กตามระบบที่จะใช้ (ตารางด้านล่าง)
#     - Security: ใส่ IP ของเครื่องนี้ (หรือ 0.0.0.0/0 ถ้า IP เปลี่ยนบ่อย — ปลอดภัยน้อยกว่า)
# EN: Create it at https://create.roblox.com/dashboard/credentials
#     - To upload assets as a group (e.g. the group's models/animations), create the key
#       INSIDE that group (Creator Dashboard → pick the group top-left → Open Cloud → API Keys)
#     - Access Permissions → "Add API System", then tick what you need (table below)
#     - Security: add this machine's IP (or 0.0.0.0/0 if it changes often — less secure)
#
# Permissions / สิทธิ์ที่ต้องกดอนุญาต:
#
#   Feature / ระบบ                        | API System         | Operations     | Resource / เลือก
#   -------------------------------------|--------------------|----------------|-------------------------------
#   Game Passes (list/create/edit/sale)  | game-pass          | Read + Write   | the experience / เกมที่จะจัดการ
#   Developer Products                   | developer-product  | Read + Write   | the experience / เกมที่จะจัดการ
#   Upload 3D models (.fbx/.gltf/.glb)   | asset              | Read + Write   | – (group key / คีย์ของกลุ่ม)
#   Upload Animations (.rbxmx)           | asset              | Read + Write   | – (group key / คีย์ของกลุ่ม)
#
# TH: asset ต้องมี Read ด้วย เพราะหลังอัปโหลดต้องอ่านผล operation เพื่อเอา assetId กลับมา
# EN: asset also needs Read: after uploading we poll the operation to get the assetId back
#
# Check what is missing / ตรวจว่าขาดสิทธิ์อะไร:
#   node bin/rsc.js permissions          (MCP tool: roblox_check_permissions)
ROBLOX_API_KEY=


# ----------------------------------------------------------------------------
# ROBLOX_UNIVERSE_ID  (Game Pass / Developer Product)
# ----------------------------------------------------------------------------
# TH: Universe ID ของเกมเริ่มต้น (ดูได้ใน Creator Dashboard → เกม → มุมขวาบน "Copy Universe ID")
# EN: Default experience (universe) id (Creator Dashboard → experience → "Copy Universe ID")
ROBLOX_UNIVERSE_ID=


# ----------------------------------------------------------------------------
# Asset owner / เจ้าของ asset ที่อัปโหลด  (set ONE of these / ใส่อย่างใดอย่างหนึ่ง)
# ----------------------------------------------------------------------------
# TH: แนะนำให้ใช้กลุ่มเจ้าของเกม — Animation ต้องเป็นของเจ้าของเกมเดียวกันจึงจะเล่นในเกมได้
# EN: Prefer the group that owns the experience — animations only play in games owned by the same creator
ROBLOX_GROUP_ID=
ROBLOX_USER_ID=


# ----------------------------------------------------------------------------
# Optional / ไม่บังคับ
# ----------------------------------------------------------------------------
# TH: เปลี่ยน base URL ตอนทดสอบ   EN: override the API base URL for testing
# ROBLOX_API_BASE_URL=https://apis.roblox.com
